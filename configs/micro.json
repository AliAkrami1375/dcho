{
  "_comment": "dcho micro. NOT a shipping model. This is the cheap probe used to compare configuration choices before committing GPU hours to a real run - roughly 1.5 hours and 1.5 USD per experiment on l4x1. Judge alignment behaviour, loss curve shape and relative ranking between configs from it; do not judge audio quality.",

  "train": {
    "seed": 1234,
    "learning_rate": 2e-4,
    "betas": [0.8, 0.99],
    "eps": 1e-9,
    "batch_size": 32,
    "lr_decay": 0.9998,
    "segment_size": 4096,
    "fp16_run": true,
    "grad_clip": 100.0,

    "c_mel": 45.0,
    "c_kl": 1.0,
    "c_subband_sc": 1.0,
    "c_subband_mag": 1.0,
    "c_dur_adv": 1.0,

    "mas_noise_scale_initial": 0.01,
    "mas_noise_scale_decay": 1e-5,

    "log_interval": 50,
    "eval_interval": 2000,
    "checkpoint_interval": 5000,
    "scorecard_interval": 5000,

    "_comment_guards": "Tighter and earlier than base: the whole point of this config is to fail fast.",
    "guards": {
      "alignment_entropy_max_at_step": {"step": 8000, "value": 0.40},
      "loss_mel_max_at_step": {"step": 8000, "value": 32.0},
      "disc_loss_min": 0.05,
      "grad_norm_max": 5000.0
    },
    "max_steps": 30000,
    "max_cost_usd": 2.50,
    "hourly_rate_usd": 0.80
  },

  "data": {
    "training_files": "manifest/micro_train.jsonl",
    "validation_files": "manifest/micro_val.jsonl",
    "sampling_rate": 16000,
    "filter_length": 1024,
    "hop_length": 256,
    "win_length": 1024,
    "n_mel_channels": 80,
    "mel_fmin": 0.0,
    "mel_fmax": 8000.0,
    "add_blank": true,
    "min_audio_seconds": 0.8,
    "max_audio_seconds": 8.0,
    "n_speakers": 8
  },

  "model": {
    "inter_channels": 96,
    "hidden_channels": 96,
    "filter_channels": 384,
    "n_heads": 2,
    "n_layers": 3,
    "kernel_size": 3,
    "p_dropout": 0.1,
    "n_flow_layers": 2,

    "resblock": "2",
    "resblock_kernel_sizes": [3, 7],
    "resblock_dilation_sizes": [[1, 3], [1, 3]],

    "upsample_rates": [4, 4],
    "upsample_initial_channel": 128,
    "upsample_kernel_sizes": [16, 16],
    "gen_istft_n_fft": 16,
    "gen_istft_hop_size": 4,
    "subbands": 4,

    "use_sdp": true,
    "use_duration_discriminator": false,
    "gin_channels": 128
  }
}
