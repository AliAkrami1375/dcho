{
  "_comment": "dcho nano. Distilled from base, for constrained targets - single-board computers, mobile, high-density serving. Trained with the base model as teacher, not from scratch.",

  "train": {
    "seed": 1234,
    "learning_rate": 2e-4,
    "betas": [0.8, 0.99],
    "eps": 1e-9,
    "batch_size": 48,
    "lr_decay": 0.999875,
    "segment_size": 8192,
    "fp16_run": true,
    "grad_clip": 100.0,

    "c_mel": 45.0,
    "c_kl": 1.0,
    "c_subband_sc": 1.0,
    "c_subband_mag": 1.0,
    "c_dur_adv": 1.0,

    "_comment_distill": "Weight on matching the teacher's latents and waveform. Set c_distill to 0 to train nano standalone, which is measurably worse.",
    "c_distill": 10.0,
    "teacher_checkpoint": "checkpoints/base/G_final.pth",

    "mas_noise_scale_initial": 0.0,
    "mas_noise_scale_decay": 0.0,

    "log_interval": 100,
    "eval_interval": 5000,
    "checkpoint_interval": 5000,
    "scorecard_interval": 10000,

    "guards": {
      "alignment_entropy_max_at_step": {"step": 20000, "value": 0.35},
      "loss_mel_max_at_step": {"step": 20000, "value": 30.0},
      "disc_loss_min": 0.05,
      "grad_norm_max": 5000.0,
      "cer_max_at_step": {"step": 50000, "value": 0.30}
    },
    "max_cost_usd": null,
    "hourly_rate_usd": 0.80
  },

  "data": {
    "training_files": "manifest/train.jsonl",
    "validation_files": "manifest/val.jsonl",
    "sampling_rate": 16000,
    "filter_length": 1024,
    "hop_length": 256,
    "win_length": 1024,
    "n_mel_channels": 80,
    "mel_fmin": 0.0,
    "mel_fmax": 8000.0,
    "add_blank": true,
    "min_audio_seconds": 0.8,
    "max_audio_seconds": 13.0,
    "n_speakers": 64
  },

  "model": {
    "inter_channels": 128,
    "hidden_channels": 128,
    "filter_channels": 512,
    "n_heads": 2,
    "n_layers": 4,
    "kernel_size": 3,
    "p_dropout": 0.1,
    "n_flow_layers": 3,

    "_comment_resblock": "ResBlock2 has 2 convolutions per block instead of 6. On a CPU this is the single biggest lever left in the decoder once iSTFT is in place.",
    "resblock": "2",
    "resblock_kernel_sizes": [3, 7, 11],
    "resblock_dilation_sizes": [[1, 3], [1, 3], [1, 3]],

    "upsample_rates": [4, 4],
    "upsample_initial_channel": 192,
    "upsample_kernel_sizes": [16, 16],
    "gen_istft_n_fft": 16,
    "gen_istft_hop_size": 4,
    "subbands": 4,

    "use_sdp": true,
    "use_duration_discriminator": true,
    "gin_channels": 192
  }
}
